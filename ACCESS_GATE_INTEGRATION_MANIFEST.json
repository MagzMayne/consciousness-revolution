  "maintenance": {
    "add_new_protected_page": {
      "step_1": "Determine tier (PERSONAL/TEAM/PUBLIC)",
      "step_2": "Add script tag: <script src=\"/js/access-gate.js\" data-tier=\"TIER\"></script>",
      "step_3": "Add to this manifest under appropriate phase",
      "step_4": "Test access grant and denial flows",
      "step_5": "Deploy to production"
    },
    "add_new_builder": {
      "step_1": "Add to BUILDER_COCKPITS in domain-tools.mjs",
      "step_2": "Get discord_id from Supabase users table",
      "step_3": "Create OPERATOR_COCKPIT_NAME.html with PERSONAL tier",
      "step_4": "Add to phase_1_critical in this manifest",
      "step_5": "Test ownership (only they can access)",
      "step_6": "Deploy"
    },
    "change_access_level": {
      "step_1": "Update ACCESS_TIERS.TEAM.level in domain-tools.mjs",
      "step_2": "Update required_xp in this manifest",
      "step_3": "Notify users of change via Discord",
      "step_4": "Deploy updated functions",
      "step_5": "Monitor denial rates"
    }
  },

  "analytics": {
