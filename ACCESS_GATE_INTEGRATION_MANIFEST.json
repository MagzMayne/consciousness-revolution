  "validation_checklist": {
    "phase_1": [
      "Tiger can access only OPERATOR_COCKPIT_TIGER.html",
      "Alex blocked from Tiger's cockpit (redirected to own)",
      "Level 2+ user can access COMMANDER_COCKPIT.html",
      "Level 1 user denied from TEAM pages (sees XP requirement)",
      "Badge appears top-right for authorized users",
      "No session users redirected to /login.html"
    ],
    "phase_2": [
      "All TEAM dashboards require level 2+",
      "Frances/Nero/Patrick cockpits accessible to all TEAM",
      "Badge updates when XP changes",
      "Denial screens show correct XP gap"
    ],
    "phase_3": [
      "PUBLIC pages require level 1+ (verified)",
      "Unverified users redirected to Discord",
      "Badges hidden on PUBLIC pages (skip_badge: true)",
      "Login preserves redirect URL"
    ]
