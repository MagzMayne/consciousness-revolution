  "purpose": "Machine-readable access control integration map for automated deployment",
  "pattern": "PERSONAL → TEAM → PUBLIC | 3 → 7 → 13 → ∞",

  "script_injection": {
    "template": "<script src=\"/js/access-gate.js\" data-tier=\"{{TIER}}\"{{SKIP_BADGE}}></script>",
    "position": "First script tag in <head>, before any other scripts",
    "attributes": {
      "data-tier": {
        "required": true,
        "values": ["PERSONAL", "TEAM", "PUBLIC"],
        "description": "Access control tier for this resource"
      },
      "data-skip-badge": {
        "required": false,
        "values": ["true"],
        "description": "Set to 'true' to hide level badge (use on login/public pages)"
      }
    }
  },

