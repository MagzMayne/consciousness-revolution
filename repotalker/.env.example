# RepoTalker – environment variables
# Copy this file to .env and fill in your values.

PORT=4000

# GitHub credentials for repo scanning
GITHUB_TOKEN=ghp_your_token_here
GITHUB_OWNER=your-org-or-user
GITHUB_REPO=your-repo-name

# Video generation API (replace with Sora, D-ID, HeyGen, etc.)
VIDEO_API_KEY=your_video_api_key_here
VIDEO_API_URL=https://video-api.example.com/generate

# Public base URL of this backend (used for asset links)
BASE_URL=http://localhost:4000