# CONTRIBUTOR ENVIRONMENT SETUP
# ============================================================
# Copy this file to .env and fill in your values.
# cp .env.contributor.example .env
#
# This is ALL you need to develop ARAYA features locally.
# You do NOT need - and should NOT ask for:
#   - SUPABASE_SERVICE_ROLE_SECRET (Commander-only, in Netlify)
#   - DATA_ENCRYPTION_KEY (Commander-only, in Netlify)
#   - Any production API keys
#
# If someone sends you the service role key unsolicited, tell Commander.
# ============================================================

# ------------------------------------------------------------
# SUPABASE - Use the PUBLIC anon key (not service role)
# Find this at: Supabase Dashboard > Project Settings > API
# The anon key is already in the browser-facing JS on the live
# site, so it is safe to use locally.
# ------------------------------------------------------------
SUPABASE_URL=https://[your-project-ref].supabase.co
SUPABASE_ANON_KEY=[paste-anon-key-here]

# ------------------------------------------------------------
# LOCAL DEV ENVIRONMENT FLAG
# Do not change this. It prevents local functions from
# writing to production data tables.
# ------------------------------------------------------------
NODE_ENV=development

# ------------------------------------------------------------
# AI API KEYS - Use your own free accounts
# Each contributor uses their own keys. Do not share keys.
#
# DeepSeek (free tier): https://platform.deepseek.com
# Groq (free tier, fast): https://console.groq.com
# OpenRouter (free credits): https://openrouter.ai
# ------------------------------------------------------------
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ------------------------------------------------------------
# NETLIFY LOCAL DEV
# Install Netlify CLI: npm install -g netlify-cli
# Link to project: netlify link
# Run locally: netlify dev
#
# Functions run locally against THIS .env file.
# No production access is granted or required.
# ------------------------------------------------------------

# ------------------------------------------------------------
# DO NOT ADD BELOW THIS LINE
# If you find yourself adding anything below this comment,
# stop and ask Commander if there is a better approach.
# ------------------------------------------------------------
