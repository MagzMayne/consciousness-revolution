// 7 FORGES DATA - Aligned with Supabase Schema
// SINGULARITY: Maps Desktop Domains <-> Forges <-> Database Slugs
// TORUS MODEL: Infinity at CENTER (position 0), 6 ring forges around it
// All frequencies are harmonics of 528 Hz (Source)
// Pattern: 3 -> 7 -> 13 -> Infinity

// Domain <-> Forge Mapping (Single Source of Truth - Torus Order)
const DOMAIN_FORGE_MAP = {
  0: { domain: "TRANSCEND",  forge: "Infinity",  slug: "infinity",  icon: "∞",  color: "#9400D3", chakra: "Crown",     hz: 528 },
  1: { domain: "COMMAND",    forge: "Reality",   slug: "reality",   icon: "🔥", color: "#FF0000", chakra: "Root",      hz: 264 },
  2: { domain: "BUILD",      forge: "Creation",  slug: "creation",  icon: "⚡", color: "#FF7F00", chakra: "Sacral",    hz: 297 },
  3: { domain: "PROTECT",    forge: "Guardian",  slug: "guardian",  icon: "🛡️", color: "#00FF00", chakra: "Solar",     hz: 330 },
  4: { domain: "CONNECT",    forge: "Signal",    slug: "signal",    icon: "📡", color: "#FFFF00", chakra: "Heart",     hz: 352 },
  5: { domain: "GROW",       forge: "Wealth",    slug: "wealth",    icon: "💰", color: "#0000FF", chakra: "Throat",    hz: 396 },
  6: { domain: "LEARN",      forge: "Character", slug: "character", icon: "👤", color: "#4B0082", chakra: "Third Eye", hz: 444 }
};

// Helper functions for domain mapping
function getDomainBySlug(slug) { return Object.values(DOMAIN_FORGE_MAP).find(d => d.slug === slug)?.domain; }
function getSlugByDomain(domain) { return Object.values(DOMAIN_FORGE_MAP).find(d => d.domain === domain)?.slug; }
function getForgeNameByDomain(domain) { return Object.values(DOMAIN_FORGE_MAP).find(d => d.domain === domain)?.forge; }
function getForgeByPosition(pos) { return DOMAIN_FORGE_MAP[pos]; }

// Pattern: 3 -> 7 -> 13 -> Infinity
