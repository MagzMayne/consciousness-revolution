// HTTP server (Go/Node.js style)
@http_server(port: 8080)
async fn handle_request(req: Request) -> Response {
    match req.path {
        "/api/users" => json(await database.get_users()),
        "/api/posts" => json(await database.get_posts()),
        _ => Response::not_found()
    }
}

// React-style components (JSX/TSX embedded)
@component
fn UserCard(user: User) -> Element {
    return (
        <div class="card">
            <h2>{user.name}</h2>
            <p>Age: {user.age}</p>
            <p>Email: {user.email.unwrap_or("N/A")}</p>
        </div>
    )
}

