// ============================================================================
// BASIC SYNTAX - Python-like simplicity
// ============================================================================

// Simple function call - AI infers everything
greet "World"

// Traditional function definition
fn greet(name: String) {
    print "Hello, {name}!"
}

// ============================================================================
// TYPE SYSTEM - TypeScript/Rust hybrid with AI inference
// ============================================================================

// AI infers types automatically
let numbers = [1, 2, 3, 4, 5]
let doubled = numbers.map(x => x * 2)

// Optional explicit types for clarity
let name: String = "BarbrickDesign"
let age: Int = 42
let email: String? = null  // Optional type (Rust/Swift style)

// Struct definition (Rust/Go style)
struct User {
    name: String,
    age: Int,
    email: String?,
    active: Bool = true  // Default value
}

// Instantiation with type inference
let user = User {
    name: "Alice",
    age: 30,
    email: "alice@example.com"
}

// ============================================================================
// PATTERN MATCHING - Haskell/Rust/Scala style
// ============================================================================

fn describe_age(age: Int) -> String {
    match age {
        0..12 => "Child",
        13..17 => "Teenager", 
        18..64 => "Adult",
        65.. => "Senior",
        _ => "Unknown"
    }
}

// Advanced pattern matching
match user {
    User { name: "Admin", .. } => print "Admin user",
    User { age: a, .. } if a > 18 => print "Adult user",
    _ => print "Regular user"
}

// ============================================================================
// FUNCTIONAL PROGRAMMING - Haskell/F#/Scala features
// ============================================================================

// Higher-order functions
let add = (x: Int, y: Int) => x + y
let multiply = (x: Int, y: Int) => x * y

// Function composition (Haskell style)
let compute = add |> multiply(2) |> add(10)

// Immutability by default
let immutable_list = [1, 2, 3]
// immutable_list.push(4)  // Error: cannot mutate immutable binding

// Explicit mutability (Rust style)
let mut mutable_list = [1, 2, 3]
mutable_list.push(4)  // OK

// Map, filter, reduce - universal syntax
let result = [1, 2, 3, 4, 5]
    .filter(x => x % 2 == 0)
    .map(x => x * x)
    .reduce(0, (acc, x) => acc + x)

// ============================================================================
// CONCURRENCY - Go/Rust/Erlang hybrid
// ============================================================================

// Async/await (JavaScript/Rust style)
async fn fetch_data(url: String) -> Result<String> {
    let response = await http.get(url)
    return response.text()
}

// Goroutine-style concurrent execution (Go style)
spawn {
    print "Running in parallel"
}

// Channels for communication (Go style)
let (sender, receiver) = channel<Int>()

spawn {
    sender.send(42)
}

let value = receiver.recv()
print "Received: {value}"

// Actor model (Erlang/Elixir style)
actor DataProcessor {
    state: Vec<Int> = []
    
    fn process(data: Int) {
        state.push(data)
        print "Processed: {data}"
    }
}

// ============================================================================
// OBJECT-ORIENTED - Java/C#/Python style
// ============================================================================

// Class with methods and properties
class Calculator {
    private history: Vec<String> = []
    
    // Constructor
    fn new() -> Self {
        Self { history: [] }
    }
    
    // Methods
    fn add(self, a: Int, b: Int) -> Int {
        let result = a + b
        self.history.push("Added {a} + {b} = {result}")
        return result
    }
    
    fn get_history(self) -> Vec<String> {
        return self.history
    }
}

// Inheritance and traits (Rust/Java hybrid)
trait Drawable {
    fn draw(self)
}

class Circle: Drawable {
    radius: Float
    
    fn draw(self) {
        print "Drawing circle with radius {self.radius}"
    }
}

// ============================================================================
// METAPROGRAMMING - Lisp/Ruby/Julia style
// ============================================================================

// Macros for code generation
macro_rules! create_getter {
    ($name:ident, $type:ty) => {
        fn $name(self) -> $type {
            return self.$name
        }
    }
}

// AI-powered code generation
@generate_crud(User)  // Automatically creates CRUD operations

// ============================================================================
// MEMORY MANAGEMENT - Rust ownership with AI assistance
// ============================================================================

// Ownership system (Rust style)
fn take_ownership(s: String) {
    print s
    // s is dropped here
}

// Borrowing (Rust style)
fn borrow_value(s: &String) {
    print s
    // s is not dropped, only borrowed
}

// AI-managed garbage collection when needed
@gc_managed
fn process_large_data(data: Vec<Int>) {
    // AI handles memory automatically
}

