fn main() {
    // Simple hello world
    print "Hello from AI Universal Language!"
    
    // Demonstrate key features
    let user = User {
        name: "BarbrickDesign",
        age: 42,
        email: "contact@barbrickdesign.com"
    }
    
    print "User: {user.name}, Age: {describe_age(user.age)}"
    
    // Async operation
    spawn {
        let data = await fetch_data("https://api.example.com/data")
        match data {
            Ok(content) => print "Fetched: {content}",
            Err(e) => print "Error: {e}"
        }
    }
    
    // Functional operations
    let numbers = [1, 2, 3, 4, 5]
    let result = numbers
        .filter(x => x % 2 == 0)
        .map(x => x * x)
        .sum()
    
    print "Result: {result}"
    
    // AI-powered query
    let users = ai query "get top 10 active users" from database
    print "Found {users.len()} users"
}

