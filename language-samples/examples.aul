/**
 * AI Universal Language (AUL) - Example Programs
 * Demonstrating the capabilities of the AUL implementation
 */

// ============================================================================
// Example 1: Basic Hello World
// ============================================================================

print "Hello, World!"
print "Welcome to AI Universal Language!"


// ============================================================================
// Example 2: Variables and Types
// ============================================================================

// Immutable variables
let name = "Alice"
let age = 30
let pi = 3.14159
let isActive = true

print "Name: " + name
print "Age: " + age

// Mutable variables
mut counter = 0
counter = counter + 1
counter = counter + 1
print "Counter: " + counter


// ============================================================================
// Example 3: Functions
// ============================================================================

// Simple function
fn greet(name) {
    print "Hello, " + name + "!"
}

greet("World")
greet("AUL")

// Function with return value
fn add(a, b) {
    return a + b
}

let sum = add(5, 3)
print "5 + 3 = " + sum

// Multiple operations
fn calculate(x, y) {
    let sum = x + y
    let diff = x - y
    let prod = x * y
    let quot = x / y
    return prod
}

print "calculate(10, 5) = " + calculate(10, 5)


// ============================================================================
// Example 4: Conditionals
// ============================================================================

fn checkAge(age) {
    if age >= 18 {
        print "You are an adult"
    } else {
        print "You are a minor"
    }
}

checkAge(25)
checkAge(15)

// Nested conditions
fn getGrade(score) {
    if score >= 90 {
        return "A"
    } else {
        if score >= 80 {
            return "B"
        } else {
            if score >= 70 {
                return "C"
            } else {
                if score >= 60 {
                    return "D"
                } else {
                    return "F"
                }
            }
        }
    }
}

print "Score 95: Grade " + getGrade(95)
print "Score 85: Grade " + getGrade(85)
print "Score 75: Grade " + getGrade(75)


// ============================================================================
// Example 5: Recursion - Fibonacci
// ============================================================================

fn fibonacci(n) {
    if n <= 1 {
        return n
    }
    return fibonacci(n - 1) + fibonacci(n - 2)
}

print "Fibonacci sequence:"
print "fib(0) = " + fibonacci(0)
print "fib(1) = " + fibonacci(1)
print "fib(5) = " + fibonacci(5)
print "fib(10) = " + fibonacci(10)
print "fib(15) = " + fibonacci(15)


// ============================================================================
// Example 6: Recursion - Factorial
// ============================================================================

fn factorial(n) {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

print "Factorials:"
print "5! = " + factorial(5)
print "7! = " + factorial(7)
print "10! = " + factorial(10)


// ============================================================================
// Example 7: Recursion - Sum of Numbers
// ============================================================================

fn sum(n) {
    if n <= 0 {
        return 0
    }
    return n + sum(n - 1)
}

print "sum(1..10) = " + sum(10)
print "sum(1..100) = " + sum(100)


// ============================================================================
// Example 8: Recursion - Power Function
// ============================================================================

fn power(base, exp) {
    if exp == 0 {
        return 1
    }
    return base * power(base, exp - 1)
}

print "2^5 = " + power(2, 5)
print "3^4 = " + power(3, 4)
print "10^3 = " + power(10, 3)


// ============================================================================
// Example 9: Closures and Higher-Order Functions
// ============================================================================

fn makeCounter() {
    mut count = 0
    fn increment() {
        count = count + 1
        return count
    }
    return increment
}

let counter1 = makeCounter()
print "Counter 1: " + counter1()
print "Counter 1: " + counter1()
print "Counter 1: " + counter1()

let counter2 = makeCounter()
print "Counter 2: " + counter2()
print "Counter 2: " + counter2()


// ============================================================================
// Example 10: Arrays
// ============================================================================

let numbers = [1, 2, 3, 4, 5]
let fruits = ["apple", "banana", "cherry"]
let mixed = [1, "two", 3, "four", 5]

print "Numbers: " + numbers
print "Fruits: " + fruits
print "Mixed: " + mixed


// ============================================================================
// Example 11: Complex Calculator
// ============================================================================

fn add(a, b) {
    return a + b
}

fn subtract(a, b) {
    return a - b
}

fn multiply(a, b) {
    return a * b
}

fn divide(a, b) {
    if b == 0 {
        print "Error: Division by zero"
        return 0
    }
    return a / b
}

fn modulo(a, b) {
    return a - (a / b * b)
}

print "=== Calculator ==="
print "10 + 5 = " + add(10, 5)
print "10 - 5 = " + subtract(10, 5)
print "10 * 5 = " + multiply(10, 5)
print "10 / 5 = " + divide(10, 5)
print "10 / 0 = " + divide(10, 0)


// ============================================================================
// Example 12: Mathematical Functions
// ============================================================================

fn abs(x) {
    if x < 0 {
        return -x
    }
    return x
}

fn max(a, b) {
    if a > b {
        return a
    }
    return b
}

fn min(a, b) {
    if a < b {
        return a
    }
    return b
}

print "abs(-5) = " + abs(-5)
print "max(10, 20) = " + max(10, 20)
print "min(10, 20) = " + min(10, 20)


// ============================================================================
// Example 13: Prime Number Checker
// ============================================================================

fn isPrime(n) {
    if n <= 1 {
        return false
    }
    if n == 2 {
        return true
    }
    
    fn checkDivisor(d) {
        if d * d > n {
            return true
        }
        if n - (n / d * d) == 0 {
            return false
        }
        return checkDivisor(d + 1)
    }
    
    return checkDivisor(2)
}

print "Is 2 prime? " + isPrime(2)
print "Is 17 prime? " + isPrime(17)
print "Is 20 prime? " + isPrime(20)
print "Is 97 prime? " + isPrime(97)


// ============================================================================
// Example 14: GCD (Greatest Common Divisor)
// ============================================================================

fn gcd(a, b) {
    if b == 0 {
        return a
    }
    return gcd(b, a - (a / b * b))
}

print "gcd(48, 18) = " + gcd(48, 18)
print "gcd(100, 35) = " + gcd(100, 35)


// ============================================================================
// Example 15: String Operations
// ============================================================================

let firstName = "John"
let lastName = "Doe"
let fullName = firstName + " " + lastName

print "Full name: " + fullName

fn repeat(str, n) {
    if n <= 0 {
        return ""
    }
    return str + repeat(str, n - 1)
}

print repeat("Ha", 3)
print repeat("*", 10)


