# Copy this to .env and fill in your values
# NEVER commit .env to git!

# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_KEY=your_service_key_here
SUPABASE_SERVICE_ROLE_SECRET=your_service_role_secret_here
SUPABASE_ANON_KEY=your_anon_key_here

# GitHub Integration
GITHUB_TOKEN=your_token_here

# AI API Keys
ANTHROPIC_API_KEY=your_key_here
DEEPSEEK_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here
GEMINI_API_KEY=your_key_here

# Airtable (if used)
AIRTABLE_API_KEY=your_key_here
AIRTABLE_BASE_ID=your_base_id_here

# Dropbox (if used)
DROPBOX_ACCESS_TOKEN=your_token_here

# Stripe Payment Processing
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Email Configuration
GMAIL_USER=your_gmail_here
GMAIL_APP_PASSWORD=your_app_password_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user_here
SMTP_PASS=your_smtp_pass_here
FROM_EMAIL=noreply@consciousnessrevolution.io

# Zero Trust Security Configuration (NEW)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here
ANONYMIZATION_SALT=your_random_salt_string_here

# Netlify Configuration
NETLIFY_AUTH_TOKEN=your_netlify_token_here

# PayPal (if used)
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here

# Twilio SMS (if used)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here
