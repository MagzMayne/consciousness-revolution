# API Keys Configuration
# Copy this file to .env and replace with your actual keys
#
# SECURITY WARNING: Never commit the .env file to version control!
#
# Quick Start:
# 1. cp .env.example .env
# 2. Edit .env and replace all placeholder values
# 3. Restart your application

# Required for Google OAuth Login - Get credentials from: https://console.cloud.google.com/
# Create OAuth 2.0 Client ID in Google Cloud Console
# See IDEA_FORGE_OAUTH_SETUP.md for detailed setup instructions
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Required for GitHub OAuth - Get credentials from: https://github.com/settings/developers
# Create a new OAuth App and copy the Client ID
# See IDEA_FORGE_OAUTH_SETUP.md for detailed setup instructions
GITHUB_CLIENT_ID=your-github-client-id

# xAI (Grok) API - Primary AI provider - Get your key from: https://console.x.ai/
# Models: grok-3, grok-3-mini, grok-2-vision-1212 — see https://docs.x.ai/developers/models
XAI_API_KEY=xai-your-xai-api-key-here
# XAI_API_KEY_CURL is an alias accepted alongside XAI_API_KEY (useful for curl-based scripts)
XAI_API_KEY_CURL=xai-your-xai-api-key-here

# Required for AI Features - Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Groq API (Free tier: 14,400 requests/day) - Get your key from: https://console.groq.com/keys
# Fast inference with Llama, Mixtral, and other open-source models
# NOTE: Repository now configured with a shared GroqAI orchestrator key for all projects
GROQ_API_KEY=gsk-your-groq-api-key-here

# Railway API Key - Used by bountyHunter.html to access Railway Station bounties
# This key authenticates requests to the Railway Station API
RAILWAY_API_KEY=your-railway-api-key-here

# Required for Government Contract Features - Get your key from: https://open.gsa.gov/api/get-opportunities-public-api/
# Free registration required at https://sam.gov/data-services
SAMGOV_API_KEY=your-samgov-api-key-here

# Required for PR Reviews and Automation - Create a Personal Access Token: https://github.com/settings/tokens
# Required scopes: repo, workflow, notifications
GITHUB_TOKEN=ghp_your-github-token-here
GITHUB_REPO_OWNER=barbrickdesign
GITHUB_REPO_NAME=barbrickdesign.github.io
GITHUB_AUTO_APPROVE=true
GITHUB_AUTO_MERGE=false
GITHUB_REQUIRE_TESTS=true
GITHUB_REQUIRE_BUILD=true

# Required for Payment Processing - Get credentials from: https://developer.paypal.com/dashboard/applications
# Use sandbox for testing, live for production
# App name: AutoBots (BarbrickDesign@gmail.com)
PAYPAL_CLIENT_ID=your-paypal-client-id-here
PAYPAL_SECRET=your-paypal-secret-here
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id-here
PAYPAL_APP_NAME=AutoBots
PAYPAL_MODE=sandbox

# Required for BankSky and Crypto Features
ETHERSCAN_API_KEY=your_etherscan_api_key_here
INFURA_PROJECT_ID=your_infura_project_id_here
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Wallet Configuration
DEFAULT_NETWORK=ethereum
SUPPORTED_NETWORKS=ethereum,bitcoin,solana

# Discord Bot Configuration - Get credentials from: https://discord.com/developers/applications
# Create a new application, enable bot, and copy the token and client ID
# Required permissions: Administrator (for full functionality)
# Required intents: Guilds, Guild Messages, Guild Members, Message Content, Guild Presences, Direct Messages
DISCORD_BOT_TOKEN=your-discord-bot-token-here
DISCORD_CLIENT_ID=your-discord-client-id-here
DISCORD_GUILD_ID=your-discord-guild-id-here
DISCORD_WEBHOOK_PORT=3010

# Service Configuration
MICRO_TX_PORT=3000
ANCHOR_PORT=3001
AFFILIATE_PORT=3002
RELAYER_PORT=3003
COMMAND_EXECUTOR_PORT=3005

# Deployment Configuration
DEPLOYMENT_TARGET=railway
VERCEL_TOKEN=your_vercel_token_here
NETLIFY_TOKEN=your_netlify_token_here

# Railway Configuration - Auto-populated by Railway on deployment
# These variables are provided by Railway and should not be manually set
# RAILWAY_ENVIRONMENT - The environment name (production, staging, etc.)
# RAILWAY_SERVICE_NAME - The name of the service
# RAILWAY_PUBLIC_DOMAIN - Public URL for this service (e.g., xyz.railway.app)
# RAILWAY_PRIVATE_DOMAIN - Private internal URL for inter-service communication
# RAILWAY_PROJECT_NAME - Your Railway project name
# RAILWAY_PROJECT_ID - Your Railway project ID
# PORT - The port Railway assigns (automatically set, usually 3000-8000)

# Backend Service URLs (Set these to Railway deployment URLs)
# Replace these after deploying services to Railway
BOUNTY_HUNTER_API_URL=http://localhost:3000
EMAIL_SERVICE_URL=http://localhost:4000
FIX_IT_SERVICE_URL=http://localhost:4001
KAS_SERVICE_URL=http://localhost:3010
GRID_CONTROL_API_URL=http://localhost:3100
MICRO_TX_SERVICE_URL=http://localhost:3000
ANCHOR_SERVICE_URL=http://localhost:3001
AFFILIATE_SERVICE_URL=http://localhost:3002
RELAYER_SERVICE_URL=http://localhost:3003

# After deploying to Railway, update these to use Railway domains:
# BOUNTY_HUNTER_API_URL=https://bounty-hunter-api-production.railway.app
# EMAIL_SERVICE_URL=https://email-service-production.railway.app
# etc.

# Database (if needed)
DATABASE_URL=your_database_url_here
REDIS_URL=your_redis_url_here

# Security
JWT_SECRET=your_jwt_secret_here
HMAC_SECRET=your_hmac_secret_here
ENCRYPTION_KEY=your_encryption_key_here

# Key Authority Service (KAS)
KAS_PORT=3010
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info
LOG_FILE=logs/banksky.log

# Feature Flags
ENABLE_AUTO_HEALING=true
ENABLE_MONITORING=true
ENABLE_ANALYTICS=true

# External Services
IPFS_GATEWAY=https://ipfs.io/ipfs/
BLOCKCYPHER_TOKEN=your_blockcypher_token_here
COINMARKETCAP_API_KEY=your_cmc_api_key_here

# GitHub PR Auto-Review Agent
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPO_OWNER=barbrickdesign
GITHUB_REPO_NAME=barbrickdesign.github.io
GITHUB_AUTO_APPROVE=true
GITHUB_AUTO_MERGE=true
GITHUB_REQUIRE_TESTS=true
GITHUB_REQUIRE_BUILD=true

# PayPal Integration
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_API=your_paypal_api_endpoint_here

# NamUs API Integration - Get your key from: https://www.namus.gov/
# Register at namus.gov to obtain API credentials for missing persons database
# Note: Rate limiting applies - consider using backend proxy for production
NAMUS_API_KEY=your_namus_api_key_here
NAMUS_API_ENDPOINT=https://www.namus.gov/api/CaseSets/NamUs
NAMUS_RATE_LIMIT_PER_HOUR=100

# Firebase Configuration - Get from: https://console.firebase.google.com/
# Create a new Firebase project and enable Auth, Firestore, and Storage
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_firebase_sender_id_here
FIREBASE_APP_ID=your_firebase_app_id_here
FIREBASE_MEASUREMENT_ID=your_firebase_measurement_id_here

# Mindat.org API - Get from: https://www.mindat.org/a/how_to_get_my_mindat_api_key
# Register at mindat.org and apply for API access (requires level 1+ account)
# Used for comprehensive mineral locality data in fluorite identification
MINDAT_API_KEY=your_mindat_api_key_here

# eBay API - Get from: https://developer.ebay.com/my/keys
# Create an application in the eBay Developer Program to get credentials
# Used for mineral marketplace, autonomous marketing, and product research
# Required for: fluoriteId.html, mineralMarket.html, marketing-agent.js
EBAY_CLIENT_ID=your_ebay_client_id_here
EBAY_CLIENT_SECRET=your_ebay_client_secret_here
EBAY_ENVIRONMENT=production
EBAY_MARKETPLACE=EBAY_US

# ==================== RepoPilot License Server ====================
# Cloudflare Workers Configuration
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
KV_NAMESPACE_ID=your_kv_namespace_id
KV_PREVIEW_ID=your_kv_preview_namespace_id
KV_PRODUCTION_ID=your_production_kv_namespace_id

# PayPal Webhook Configuration (for RepoPilot)
PAYPAL_WEBHOOK_SECRET=your_paypal_webhook_secret
PAYPAL_WEBHOOK_URL=https://repopilot-license-server.your-subdomain.workers.dev/api/webhook/paypal

# Email Service Configuration (Choose ONE)
# Option 0: Gmail OAuth 2.0 (most secure; supports both SENDING and READING inbox)
# Set up: https://console.cloud.google.com/ → Create OAuth 2.0 credentials → Gmail API
# Get refresh token via OAuth playground: https://developers.google.com/oauthplayground/
# Required scope: https://mail.google.com/
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-gmail-oauth-refresh-token

# Option 1: SMTP (works with Gmail, Outlook, custom mail servers)
# For Gmail: enable "App Passwords" at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

# Agent Email Domain — used to build per-agent addresses
# e.g. AGENT_EMAIL_DOMAIN=barbrickdesign.com → agent-merlin@barbrickdesign.com
AGENT_EMAIL_DOMAIN=barbrickdesign.com

# Option 2: SendGrid - Get from: https://sendgrid.com/
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@barbrickdesign.com
SENDGRID_FROM_NAME=RepoPilot License System

# Option 3: Mailgun - Get from: https://www.mailgun.com/
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=your_mailgun_domain
MAILGUN_FROM_EMAIL=noreply@barbrickdesign.com

# Option 3: AWS SES
AWS_SES_ACCESS_KEY_ID=your_aws_access_key
AWS_SES_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_SES_REGION=us-east-1
AWS_SES_FROM_EMAIL=noreply@barbrickdesign.com

# License Server Configuration
SECRET_SALT=your_very_long_random_secret_salt_string_here
LICENSE_SERVER_URL=https://repopilot-license-server.your-subdomain.workers.dev
PRODUCTION_LICENSE_SERVER=https://repopilot-license-server.your-subdomain.workers.dev

# Security Monitor Configuration
SECURITY_ALERT_EMAIL=BarbrickDesign@gmail.com

# Optional: Custom Domain
CUSTOM_DOMAIN=license.barbrickdesign.com
