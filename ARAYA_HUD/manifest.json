{
  "manifest_version": 3,
  "name": "ARAYA - Life Transformation HUD",
  "version": "2.0.0",
  "description": "Your AI ally for organizing life across 7 domains + code capture from AI platforms",
  "permissions": [
    "activeTab",
    "storage",
    "sidePanel",
    "tabs",
    "contextMenus",
    "nativeMessaging",
    "clipboardWrite"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/observer.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://claude.ai/*",
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://chat.deepseek.com/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*"
      ],
      "js": [
        "content/code-detector.js",
        "content/code-capture.js"
      ],
      "css": ["styles/code-capture.css"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel/araya-sidebar.html"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ARAYA - 7 Domains"
  },
  "icons": {
    "16": "icons/araya-16.png",
    "48": "icons/araya-48.png",
    "128": "icons/araya-128.png"
  },
  "externally_connectable": {
    "matches": ["https://conciousnessrevolution.io/*"]
  }
}
