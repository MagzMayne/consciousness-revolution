{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Universal Beta DNA Schema",
  "description": "Embedded metadata schema for all 100X Builder artifacts - enables lineage tracking, phase management, and evolution transparency",
  "version": "1.0.0",
  "type": "object",
  "required": ["identity", "phase", "lineage", "blueprint"],
  "properties": {
    "identity": {
      "type": "object",
      "description": "Core identification metadata",
      "required": ["name", "filename", "version", "created_date", "created_by"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Human-readable display name",
          "examples": ["Trinity Command Dashboard", "Araya Chat Engine", "Domain 7 Transcendence Portal"]
        },
        "filename": {
          "type": "string",
          "description": "Actual filename following naming convention",
          "pattern": "^[A-Z0-9_]+\\.(html|json|md|js|mjs|py|sql)$",
          "examples": ["TRINITY_COMMAND_DASHBOARD.html", "ARAYA_CHAT_ENGINE.mjs", "DOMAIN_7_TRANSCEND_PORTAL_v2.html"]
        },
        "version": {
          "type": "string",
          "description": "Semantic versioning (major.minor.patch)",
          "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9]+)?$",
          "examples": ["0.1.0-alpha", "1.2.3", "2.0.0-beta.5"]
        },
        "created_date": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of creation",
          "examples": ["2026-02-24T18:30:00Z"]
        },
        "created_by": {
          "type": "string",
          "description": "Creator identifier (Commander, C1, C2, C3, or team member)",
          "enum": ["Commander", "C1_Mechanic", "C2_Architect", "C3_Oracle", "Josh", "Toby", "William_B", "Dean", "William_V", "Rutherford", "Agent_R"],
          "examples": ["C2_Architect", "Commander", "Josh"]
        },
        "last_edited": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of last modification"
        },
        "edited_by": {
          "type": "string",
          "description": "Last editor identifier"
        },
        "uuid": {
          "type": "string",
          "format": "uuid",
          "description": "Optional unique identifier for cross-reference"
        }
      }
    },
    "phase": {
      "type": "object",
      "description": "Development phase and stability tracking",
      "required": ["current_phase", "stability", "completion_percentage"],
      "properties": {
        "current_phase": {
          "type": "string",
          "enum": ["CONCEPT", "ALPHA", "BETA", "RELEASE", "GOLD", "DEPRECATED"],
          "description": "Current development phase",
          "definitions": {
            "CONCEPT": "Idea stage, design only, no code",
            "ALPHA": "Early implementation, internal testing only, expect breaking changes",
            "BETA": "Feature complete, public testing, stability improvements",
            "RELEASE": "Production ready, stable API, documented",
            "GOLD": "Battle-tested, optimized, reference implementation",
            "DEPRECATED": "Replaced by newer version, marked for removal"
          }
        },
        "stability": {
          "type": "string",
          "enum": ["experimental", "unstable", "stable", "production", "deprecated"],
          "description": "Stability level independent of phase"
        },
        "completion_percentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Percentage of target features implemented"
        },
        "breaking_changes": {
          "type": "boolean",
          "description": "Whether this version includes breaking changes from previous",
          "default": false
        },
        "public_access": {
          "type": "boolean",
          "description": "Whether this is publicly accessible",
          "default": false
        },
        "tested": {
          "type": "boolean",
          "description": "Whether automated or manual testing has been performed",
          "default": false
        }
      }
    },
    "lineage": {
      "type": "object",
      "description": "Relationship mapping and genealogy",
      "properties": {
        "parent_document": {
          "type": ["string", "null"],
          "description": "Filename of the document that spawned this one",
          "examples": ["COMMANDER_COCKPIT_v1.html", null]
        },
        "children_documents": {
          "type": "array",
          "description": "Filenames of documents spawned from this one",
          "items": {
            "type": "string"
          },
          "default": [],
          "examples": [["COMMANDER_DOMAIN_1_COMMAND.html", "COMMANDER_DOMAIN_2_BUILD.html"]]
        },
        "related_documents": {
          "type": "array",
          "description": "Sibling documents or dependencies (not parent/child)",
          "items": {
            "type": "string"
          },
          "default": [],
          "examples": [["TRINITY_COMMAND_DASHBOARD.html", "BRAIN_QUERY_DASHBOARD.html"]]
        },
        "replaces": {
          "type": ["string", "null"],
          "description": "Deprecated document this version replaces",
          "examples": ["COMMANDER_DASHBOARD_OLD.html", null]
        },
        "replaced_by": {
          "type": ["string", "null"],
          "description": "Newer document that replaces this (if deprecated)",
          "examples": ["COMMANDER_COCKPIT_v3.html", null]
        },
        "domain": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "description": "Primary domain (1-7 Pattern Theory, 8=Blueprint)",
          "definitions": {
            "1": "COMMAND - Leadership, coordination, decision-making",
            "2": "BUILD - Creation, implementation, construction",
            "3": "CONNECT - Communication, integration, networking",
            "4": "PROTECT - Security, safety, defense systems",
            "5": "GROW - Expansion, scaling, optimization",
            "6": "LEARN - Education, knowledge, skill development",
            "7": "TRANSCEND - Innovation, transformation, emergence",
            "8": "BLUEPRINT - Meta-architecture, system design"
          }
        },
        "secondary_domains": {
          "type": "array",
          "description": "Additional domains this artifact touches",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "default": []
        }
      }
    },
    "blueprint": {
      "type": "object",
      "description": "Future vision and evolution roadmap",
      "required": ["target_phase", "target_features", "missing_features", "next_steps"],
      "properties": {
        "target_phase": {
          "type": "string",
          "enum": ["ALPHA", "BETA", "RELEASE", "GOLD"],
          "description": "Intended final phase for this artifact",
          "default": "GOLD"
        },
        "target_features": {
          "type": "array",
          "description": "Complete list of intended features when GOLD",
          "items": {
            "type": "string"
          },
          "examples": [["Real-time sync", "Offline mode", "Multi-language support", "AI integration"]]
        },
        "implemented_features": {
          "type": "array",
          "description": "Features currently working",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "missing_features": {
          "type": "array",
          "description": "Features not yet implemented from target list",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "next_steps": {
          "type": "array",
          "description": "Ordered list of immediate next actions",
          "items": {
            "type": "object",
            "required": ["action", "priority"],
            "properties": {
              "action": {
                "type": "string",
                "description": "Specific actionable step"
              },
              "priority": {
                "type": "string",
                "enum": ["P0_CRITICAL", "P1_HIGH", "P2_MEDIUM", "P3_LOW"],
                "description": "Priority level"
              },
              "assigned_to": {
                "type": "string",
                "description": "Who should handle this (optional)"
              },
              "estimated_hours": {
                "type": "number",
                "description": "Time estimate in hours (optional)"
              }
            }
          },
          "examples": [[
            {"action": "Add authentication layer", "priority": "P0_CRITICAL", "assigned_to": "C1_Mechanic", "estimated_hours": 4},
            {"action": "Implement error logging", "priority": "P1_HIGH", "estimated_hours": 2}
          ]]
        },
        "known_issues": {
          "type": "array",
          "description": "Documented bugs or limitations",
          "items": {
            "type": "object",
            "properties": {
              "issue": {"type": "string"},
              "severity": {"type": "string", "enum": ["critical", "major", "minor", "cosmetic"]},
              "workaround": {"type": "string"}
            }
          },
          "default": []
        },
        "tech_debt": {
          "type": "array",
          "description": "Technical debt items to address",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "classification": {
      "type": "object",
      "description": "Categorization and tagging",
      "properties": {
        "artifact_type": {
          "type": "string",
          "enum": ["DASHBOARD", "COCKPIT", "HUB", "TOOL", "ENGINE", "PORTAL", "API", "SCHEMA", "GUIDE", "TEMPLATE"],
          "description": "Primary artifact category"
        },
        "owner": {
          "type": "string",
          "enum": ["COMMANDER", "AGENT_R", "TEAM", "BETA_TESTERS", "PUBLIC", "SYSTEM"],
          "description": "Primary intended user/owner"
        },
        "access_level": {
          "type": "string",
          "enum": ["PRIVATE", "TEAM", "BETA", "PUBLIC"],
          "description": "Access restriction level"
        },
        "tags": {
          "type": "array",
          "description": "Searchable tags",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "pattern_theory_compliance": {
          "type": "boolean",
          "description": "Whether artifact follows 7-domain Pattern Theory",
          "default": true
        }
      }
    },
    "integration": {
      "type": "object",
      "description": "External dependencies and connections",
      "properties": {
        "dependencies": {
          "type": "array",
          "description": "Required external libraries/services",
          "items": {
            "type": "object",
            "properties": {
              "name": {"type": "string"},
              "version": {"type": "string"},
              "required": {"type": "boolean", "default": true}
            }
          },
          "default": []
        },
        "apis_used": {
          "type": "array",
          "description": "External APIs this artifact calls",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "apis_provided": {
          "type": "array",
          "description": "Endpoints this artifact exposes",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "database_tables": {
          "type": "array",
          "description": "Database tables accessed (if applicable)",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "metrics": {
      "type": "object",
      "description": "Performance and usage tracking",
      "properties": {
        "lines_of_code": {
          "type": "number",
          "description": "Approximate LOC count"
        },
        "last_tested": {
          "type": "string",
          "format": "date-time",
          "description": "When last tested"
        },
        "test_coverage_percentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Code coverage percentage"
        },
        "active_users": {
          "type": "number",
          "description": "Number of active users (if tracked)"
        },
        "feedback_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "Average user feedback score (0-10)"
        }
      }
    },
    "changelog": {
      "type": "array",
      "description": "Version history log",
      "items": {
        "type": "object",
        "required": ["version", "date", "changes"],
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9]+)?$"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "author": {
            "type": "string"
          },
          "changes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "breaking_changes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          }
        }
      },
      "default": []
    }
  }
}
