{
  "version": "1.0.0",
  "name": "AgentSwarm",
  "description": "7-Layer autonomous agent swarm architecture for Barbrick Design",
  "owner": "Ryan Barbrick",
  "email": "BarbrickDesign@gmail.com",
  "paymentRoute": "BarbrickDesign@gmail.com",
  "timestamp": "2026-02-22T00:00:00.000Z",

  "layers": {
    "1_human_strategy": {
      "name": "Human Strategy Layer",
      "description": "Top-level oversight and strategic direction provided by Ryan Barbrick (Agent R)",
      "actors": ["Agent R", "Ryan Barbrick"],
      "responsibilities": [
        "Set high-level goals and priorities",
        "Approve or veto meta-agent decisions",
        "Review swarm health reports"
      ]
    },

    "2_meta_agent": {
      "name": "Meta-Agent Layer",
      "description": "agentR oversees all agents, approves high-impact actions, manages registries, evolves workflows",
      "primaryAgent": "agentR",
      "manifest": "agent-r-manifest.json",
      "module": "src/agents/swarm-orchestrator.js",
      "responsibilities": [
        "Oversee all sub-agents",
        "Approve high-impact actions",
        "Manage agent registries",
        "Evolve swarm workflows"
      ],
      "authorities": ["full_system_access", "agent_orchestration", "governance_decisions"]
    },

    "3_automation_assistance": {
      "name": "Automation Assistance Layer",
      "description": "Research aggregation, draft generation, monitoring + alerts, opportunity scanning",
      "module": "src/agents/automation-assistance-agent.js",
      "agents": [
        {
          "id": "research-aggregator",
          "role": "Research aggregation",
          "schedule": "0 * * * *"
        },
        {
          "id": "draft-generator",
          "role": "Draft generation",
          "schedule": "on-demand"
        },
        {
          "id": "monitor-alert",
          "role": "Monitoring + alerts",
          "schedule": "*/5 * * * *"
        },
        {
          "id": "opportunity-scanner",
          "role": "Opportunity scanning",
          "schedule": "0 */6 * * *"
        }
      ]
    },

    "4_execution": {
      "name": "Execution Agent Layer",
      "description": "Outreach, proposal, builder, reporting, and update agents",
      "agents": [
        {
          "id": "outreach",
          "role": "Outreach agents",
          "module": "src/agents/celebrity-outreach-agent.js"
        },
        {
          "id": "proposal",
          "role": "Proposal agents",
          "module": "src/agents/proposal-generator-agent.js"
        },
        {
          "id": "builder",
          "role": "Builder agents",
          "module": "src/agents/deployment-agent.js"
        },
        {
          "id": "reporting",
          "role": "Reporting agents",
          "module": "src/agents/report-generator-agent.js"
        },
        {
          "id": "update",
          "role": "Update agents",
          "module": "src/agents/management-agent.js"
        }
      ]
    },

    "5_delivery_operations": {
      "name": "Delivery & Operations Layer",
      "description": "Contractor network, client dashboards, automated reporting, billing + invoicing",
      "module": "src/agents/delivery-operations-agent.js",
      "components": [
        "contractor-network",
        "client-dashboards",
        "automated-reporting",
        "billing-invoicing"
      ],
      "paymentEmail": "BarbrickDesign@gmail.com"
    },

    "6_product_surfaces": {
      "name": "Product Surfaces",
      "description": "Automation agency, Vertical SaaS, Template marketplace, Deal-flow engine, Bounty harvester",
      "products": [
        {
          "id": "automation-agency",
          "name": "Automation Agency",
          "url": "/aFactory.html"
        },
        {
          "id": "vertical-saas",
          "name": "Vertical SaaS",
          "url": "/repopilot-landing.html"
        },
        {
          "id": "template-marketplace",
          "name": "Template Marketplace",
          "url": "/template-marketplace.html"
        },
        {
          "id": "deal-flow-engine",
          "name": "Deal-Flow Engine",
          "url": "/FuturesByAgentR.html"
        },
        {
          "id": "bounty-harvester",
          "name": "Bounty Harvester",
          "url": "/bounty-harvester.html"
        }
      ]
    },

    "7_control_bridge": {
      "name": "Control Bridge (GUI)",
      "description": "Oversight, logs, kill switch, daemon status, pipeline routing",
      "url": "/control-bridge.html",
      "features": [
        "oversight",
        "logs",
        "kill-switch",
        "daemon-status",
        "pipeline-routing"
      ]
    }
  },

  "coordinator": {
    "module": "src/agents/agent-coordinator.js",
    "logger": "src/agents/agent-logger.js"
  },

  "payments": {
    "method": "PayPal donation",
    "email": "BarbrickDesign@gmail.com",
    "note": "All end-product and service payments routed to BarbrickDesign@gmail.com"
  }
}
