{
  "manifest_version": 3,
  "name": "ARIA - AI Response & Insight Archiver",
  "version": "1.0.0",
  "description": "Capture, organize, and export code blocks from Claude, ChatGPT, DeepSeek and other AI platforms",
  "permissions": [
    "activeTab",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://chat.deepseek.com/*",
    "https://gemini.google.com/*",
    "https://copilot.microsoft.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://chat.deepseek.com/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*"
      ],
      "js": [
        "content/detector.js",
        "content/parser.js",
        "content/injector.js"
      ],
      "css": [
        "styles/injected.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/aria-16.png",
      "48": "icons/aria-48.png",
      "128": "icons/aria-128.png"
    }
  },
  "icons": {
    "16": "icons/aria-16.png",
    "48": "icons/aria-48.png",
    "128": "icons/aria-128.png"
  }
}
