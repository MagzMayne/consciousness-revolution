{
  "providers": ["node"],
  "phases": {
    "setup": {
      "nixPkgs": ["nodejs_18"],
      "nixLibs": [],
      "nixOverlays": [],
      "aptPkgs": []
    },
    "install": {
      "cmds": [
        "npm ci",
        "cd backend && npm ci"
      ]
    },
    "build": {
      "cmds": [
        "npm run build"
      ]
    }
  },
  "start": {
    "cmd": "node backend/server-main.js"
  },
  "variables": {
    "NODE_ENV": "production"
  }
}
