{
  "bot": {
    "name": "BarbrickDesign Bot",
    "version": "1.0.0",
    "description": "Comprehensive Discord bot for BarbrickDesign repository management",
    "prefix": "/",
    "owner_id": ""
  },
  "features": {
    "slash_commands": true,
    "webhooks": true,
    "notifications": true,
    "github_integration": true,
    "service_management": true,
    "api_key_management": true
  },
  "permissions": {
    "roles": {
      "admin": {
        "commands": ["deploy", "apikey", "webhook"],
        "required_permission": "Administrator"
      },
      "moderator": {
        "commands": ["github", "sql", "safety"],
        "required_permission": "ManageMessages"
      },
      "user": {
        "commands": ["help", "status", "project", "banksky", "notification"],
        "required_permission": "SendMessages"
      }
    }
  },
  "channels": {
    "notifications": "notifications",
    "github_events": "github-events",
    "deployments": "deployments",
    "system_alerts": "system-alerts",
    "general": "general"
  },
  "webhooks": {
    "github": {
      "enabled": true,
      "events": ["push", "pull_request", "issues", "release"],
      "endpoint": "/webhook/github"
    },
    "deployment": {
      "enabled": true,
      "endpoint": "/webhook/deployment"
    },
    "system": {
      "enabled": true,
      "endpoint": "/webhook/system"
    }
  },
  "services": {
    "banksky": {
      "name": "BankSky",
      "url": "https://barbrickdesign.github.io/BankSky.html",
      "ports": {
        "micro_tx": 3000,
        "anchor": 3001,
        "affiliate": 3002,
        "relayer": 3003,
        "command_executor": 3005
      }
    },
    "backend": {
      "name": "Backend Services",
      "path": "./backend"
    }
  },
  "notifications": {
    "deployment": {
      "enabled": true,
      "channel": "deployments",
      "mention_roles": ["@Admin"]
    },
    "github": {
      "enabled": true,
      "channel": "github-events",
      "events": ["push", "pull_request"]
    },
    "alerts": {
      "enabled": true,
      "channel": "system-alerts",
      "mention_roles": ["@Admin", "@Moderator"]
    }
  },
  "rate_limits": {
    "commands_per_minute": 30,
    "commands_per_user_per_minute": 5
  },
  "logging": {
    "level": "info",
    "log_commands": true,
    "log_errors": true,
    "log_webhooks": true
  }
}
