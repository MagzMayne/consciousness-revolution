# Netlify Redirects Configuration
# https://docs.netlify.com/routing/redirects/

# TRINITY - Your Pocket Boardroom (force redirect, don't fall through)
/trinity  https://trinity-api-production-dff4.up.railway.app/  302!
/trinity/  https://trinity-api-production-dff4.up.railway.app/  302!

# API routes to serverless functions
/api/*  /.netlify/functions/:splat  200

# Legacy routes and redirects
/old-index.html  /index.html  301
/old-dashboard.html  /dashboard.html  301

# Preserve query parameters
/search/*  /index.html  200

# Handle HTML files without extension
/about  /about.html  200
/contact  /contact.html  200
/dev-tracker  /dev-tracker.html  200

# SPA fallback - serve index.html for all non-file routes
/*  /index.html  200
