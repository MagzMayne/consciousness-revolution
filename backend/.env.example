# BankSky Backend Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# API KEYS & SECRETS
# ============================================================================

# Etherscan API (get from https://etherscan.io/apis)
ETHERSCAN_API_KEY=YourEtherscanApiKeyHere

# Infura Project (get from https://infura.io)
INFURA_PROJECT_ID=YourInfuraProjectId
INFURA_PROJECT_SECRET=YourInfuraProjectSecret

# ============================================================================
# WALLET CONFIGURATION
# ============================================================================

# Relayer wallet private key (NEVER commit this to git)
# This wallet will be used for meta-transactions and contract interactions
PRIVATE_KEY=0xYourPrivateKeyHere

# ============================================================================
# BITCOIN NODE (Optional - for OP_RETURN anchoring)
# ============================================================================

# Bitcoin RPC configuration (optional)
BITCOIN_RPC_HOST=127.0.0.1
BITCOIN_RPC_PORT=8332
BITCOIN_RPC_USER=bitcoinrpc
BITCOIN_RPC_PASS=YourSecurePasswordHere

# ============================================================================
# SERVICE URLS (Auto-filled after deployment)
# ============================================================================

# These will be auto-populated after running deployment
MICRO_TX_URL=https://your-micro-tx-service.vercel.app
ANCHOR_URL=https://your-anchor-service.vercel.app
AFFILIATE_URL=https://your-affiliate-service.vercel.app
RELAYER_URL=https://your-relayer-service.vercel.app

# ============================================================================
# CONTRACT ADDRESSES (Auto-filled after deployment)
# ============================================================================

VAULTCOIN_ADDRESS=0x0000000000000000000000000000000000000000

# ============================================================================
# MONITORING & LOGGING
# ============================================================================

# Enable detailed logging (true/false)
ENABLE_DETAILED_LOGGING=true

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Health check interval (seconds)
HEALTH_CHECK_INTERVAL=30

# Auto-healing settings
AUTO_HEALING_ENABLED=true
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_MULTIPLIER=2

# ============================================================================
# SECURITY SETTINGS
# ============================================================================

# CORS allowed origins (comma-separated)
CORS_ORIGINS=https://barbrickdesign.github.io,https://yourdomain.com

# Rate limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# JWT Secret (for any authenticated endpoints)
JWT_SECRET=YourSecureJwtSecretHere

# ============================================================================
# DATABASE (Optional - for persistent storage)
# ============================================================================

# MongoDB connection (optional - falls back to file storage)
MONGODB_URI=mongodb://localhost:27017/banksky

# Redis for caching (optional)
REDIS_URL=redis://localhost:6379

# ============================================================================
# EMAIL/SMS ALERTS (Optional)
# ============================================================================

# SMTP configuration for alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# SMS alerts (Twilio)
TWILIO_SID=YourTwilioSid
TWILIO_TOKEN=YourTwilioToken
TWILIO_FROM=+1234567890

# Alert recipients
ALERT_EMAILS=admin@yourdomain.com,dev@yourdomain.com
ALERT_PHONES=+1234567890,+0987654321

# Discord webhook URL (for notifications)
DISCORD_WEBHOOK_URL=http://localhost:3010

# ============================================================================
# GEM SCRAPER SERVICE (Instagram & eBay Automation)
# ============================================================================

# Gem Scraper Service port
GEM_SCRAPER_PORT=3010

# RapidAPI Key (for Instagram scraping)
# Get from: https://rapidapi.com/ (Instagram Scraper API)
RAPIDAPI_KEY=YourRapidAPIKeyHere

# eBay API App ID (optional - uses fallback scraping if not provided)
# Get from: https://developer.ebay.com/
EBAY_APP_ID=YourEbayAppIdHere

# ============================================================================
# ADVANCED SETTINGS
# ============================================================================

# Gas price monitoring
GAS_PRICE_UPDATE_INTERVAL=60
MAX_GAS_PRICE=50000000000

# Transaction timeouts (seconds)
TX_TIMEOUT_BTC=3600
TX_TIMEOUT_ETH=300

# Cache settings
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# Backup settings
BACKUP_INTERVAL=86400
BACKUP_RETENTION_DAYS=30
