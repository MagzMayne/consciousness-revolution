# Railway Ignore File
# Prevent Railway from detecting Ruby/Python files that are only used for GitHub Pages Jekyll or local tools

# Ruby files (GitHub Pages Jekyll only)
Gemfile
Gemfile.lock
.ruby-version
.ruby-gemset
_config.yml
_layouts/
.jekyll-cache/

# Python files (local development tools only)
.python-version
*.py
__pycache__/
*.pyc
venv/
env/

# These files are for GitHub Pages and local development only, not for Railway deployment
