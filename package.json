{
  "name": "banksky-platform",
  "version": "2.4.0",
  "description": "BankSky - Complete DeFi Agentic Bank with Self-Healing Backend Infrastructure",
  "main": "BankSky.html",
  "scripts": {
    "start": "node start-banksky.js",
    "dev": "node start-banksky.js --dev",
    "backend": "cd backend && npm run dev",
    "backend-setup": "cd backend && npm install",
    "kas": "node start-kas-service.js",
    "kas:start": "node start-kas-service.js",
    "kas:service": "node backend/services/kas-service.js",
    "kas:test": "./test-autokey-authentication.sh",
    "test:kas": "node backend/test-kas-authentication.js",
    "test:auth": "./test-autokey-authentication.sh",
    "email-service": "node backend/services/email-service.js",
    "email:start": "node backend/services/email-service.js",
    "master-system": "npm run email-service",
    "deploy": "node deploy-banksky.js",
    "test": "node test-banksky.js",
    "test:api": "node test-api-connections.js",
    "test:api-connections": "node test-api-connections.js",
    "setup:api": "node backend-api-key-manager.js",
    "setup:api-keys": "node backend-api-key-manager.js",
    "health": "node backend-health-checker.js",
    "health:check": "node backend-health-checker.js",
    "monitor": "node backend-monitor.js start",
    "monitor:status": "node backend-monitor.js status",
    "fix:errors": "node backend-error-injector.js",
    "fix:errors:dry-run": "node backend-error-injector.js --dry-run",
    "setup": "npm install && cd backend && npm install",
    "local": "npm run setup && npm run dev",
    "build": "mkdir -p dist && cp -r src/* dist/ 2>/dev/null || true && cp *.html dist/ 2>/dev/null || true && cp service-worker.js dist/ 2>/dev/null || true",
    "clean": "rm -rf dist/ node_modules/ backend/node_modules/ 2>/dev/null || true",
    "banksky": "node banksky-deploy.js",
    "evaluate": "node run-file-evaluation.js",
    "evaluate:verbose": "node run-file-evaluation.js --verbose",
    "evaluate:quiet": "node run-file-evaluation.js --quiet",
    "evaluate:example": "node example-evaluation.js",
    "sign": "node sign-repository-files.js",
    "sign:dry-run": "node sign-repository-files.js --dry-run",
    "sign:force": "node sign-repository-files.js --force",
    "crawl": "node crawl-network-links.js",
    "crawl:output": "node crawl-network-links.js --output",
    "analyze:sql": "node sql-analyzer-cli.js",
    "analyze:sql:scan": "node sql-analyzer-cli.js --scan --output markdown",
    "analyze:sql:json": "node sql-analyzer-cli.js --scan --output json --export sql-analysis-report.json",
    "analyze:sql:autofix": "node sql-analyzer-cli.js --scan --auto-fix --export sql-autofix.sql",
    "analyze:sql:ci": "node sql-analyzer-cli.js --scan --ci",
    "inject:anti-nuke": "node inject-anti-nuke-safety.js",
    "safety:check": "echo 'Checking anti-nuke safety system...' && node -e \"require('./anti-nuke-safety.js')\"",
    "safety:report": "node -e \"console.log('Loading anti-nuke safety...'); require('./anti-nuke-safety.js'); setTimeout(() => { if (typeof AntiNukeSafety !== 'undefined') AntiNukeSafety.getReport(); }, 100);\"",
    "inject:vehicle-safety": "node inject-ai-vehicle-safety.js",
    "vehicle:check": "echo 'Checking AI vehicle safety system...' && node -e \"require('./ai-vehicle-safety.js')\"",
    "vehicle:report": "node -e \"console.log('Loading AI vehicle safety...'); require('./ai-vehicle-safety.js'); setTimeout(() => { if (typeof AIVehicleSafety !== 'undefined') AIVehicleSafety.getReport(); }, 100);\"",
    "vehicle:dashboard": "echo 'Open ai-vehicle-dashboard.html in your browser'",
    "discord:bot": "node discord-bot.js",
    "discord:start": "node discord-bot.js",
    "discord:dev": "nodemon discord-bot.js",
    "discord:setup": "node setup-discord-bot.js",
    "discord:test": "node test-discord-integration.js",
    "discord:enhance": "node enhance-all-scripts-discord.js",
    "discord:abilities": "node show-discord-abilities.js",
    "patent:scan": "node generate-patents.js --scan",
    "patent:idea": "node generate-patents.js --idea",
    "patent:list": "node generate-patents.js --list",
    "patent:help": "node generate-patents.js",
    "test:trinity": "node test-trinity-loop-complete.js",
    "trinity:test": "node test-trinity-loop-complete.js",
    "redundancy:check": "echo 'Open redundancy-checker.html in your browser to check for redundant ideas'",
    "redundancy:help": "cat REDUNDANCY_CHECKER_README.md",
    "netlify:validate": "node validate-netlify-config.js",
    "netlify:check": "node validate-netlify-config.js"
  },
  "keywords": [
    "defi",
    "banksky",
    "web3",
    "blockchain",
    "agentic",
    "self-healing",
    "microservices",
    "deployment",
    "ethereum",
    "bitcoin",
    "solana",
    "vaultcoin",
    "ipfs",
    "anchoring"
  ],
  "author": "BankSky Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "serve-handler": "^6.1.5",
    "axios": "^1.13.5",
    "node-cron": "^3.0.3",
    "dotenv": "^16.3.1",
    "discord.js": "^14.14.1",
    "jsonwebtoken": "^9.0.2",
    "@tensorflow/tfjs": "^4.17.0",
    "@tensorflow/tfjs-node": "^4.17.0",
    "@tensorflow-models/universal-sentence-encoder": "^1.3.3",
    "@tensorflow-models/toxicity": "^1.2.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=7.0.0"
  },
  "directories": {
    "src": "src",
    "backend": "backend",
    "dist": "dist",
    "docs": "docs",
    "test": "tests"
  },
  "banksky": {
    "version": "1.0",
    "services": {
      "micro-tx": 3000,
      "anchor": 3001,
      "affiliate": 3002,
      "relayer": 3003,
      "command-executor": 3005
    },
    "deployment": {
      "autoDetectNode": true,
      "selfHealing": true,
      "monitoring": true,
      "environmentAware": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/barbrickdesign/barbrickdesign.github.io.git"
  },
  "consolidated": {
    "sharedWalletSystem": "src/utils/shared-wallet-system.js",
    "sharedAgentSystem": "src/utils/shared-agent-system.js",
    "sharedUtilities": "src/utils/shared-utilities.js",
    "redundantFilesRemoved": 15,
    "codeDuplicationReduced": "60%"
  }
}
