# Docker/Nixpacks Ignore File
# Exclude files that shouldn't be in the build context

# Version control
.git
.gitignore
.github/

# Ruby (GitHub Pages only)
Gemfile
Gemfile.lock
.ruby-version
.ruby-gemset
_config.yml
_layouts/
.jekyll-cache/
*.gem

# Python (local tools only)
.python-version
*.py
__pycache__/
*.pyc
*.pyo
*.pyd
venv/
env/
*.egg-info/

# Node modules (will be installed fresh)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build artifacts
dist/
.cache/
.temp/
.tmp/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Documentation
*.md
docs/
README*
CHANGELOG*
LICENSE
CONTRIBUTING*

# Tests
test/
tests/
*.test.js
*.spec.js

# Logs
*.log
logs/

# Large binary files
*.zip
*.tar.gz
*.gcs
*.gem
