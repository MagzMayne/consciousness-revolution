{
  "version": "1.0",
  "updated": "2026-02-21",
  "purpose": "Access control registry - defines what is PUBLIC vs PRIVATE",

  "access_levels": {
    "public": "Anyone on the internet can see this",
    "authenticated": "Requires login/email verification",
    "team": "Internal team members only",
    "commander": "Commander/Admin only"
  },

  "public_pages": {
    "description": "Safe for anyone to see",
    "pages": [
      {"path": "/index.html", "purpose": "Landing page"},
      {"path": "/araya-chat.html", "purpose": "Public AI chat"},
      {"path": "/araya-welcome.html", "purpose": "Welcome page"},
      {"path": "/araya-light.html", "purpose": "Lightweight chat"},
      {"path": "/login.html", "purpose": "Login page"},
      {"path": "/signup.html", "purpose": "Signup page"},
      {"path": "/pricing.html", "purpose": "Pricing info"},
      {"path": "/store.html", "purpose": "Public store"},
      {"path": "/ABOUT.html", "purpose": "About page"},
      {"path": "/offline.html", "purpose": "Offline fallback"}
    ]
  },

  "authenticated_pages": {
    "description": "Requires login to access",
    "pages": [
      {"path": "/dashboard.html", "purpose": "User dashboard"},
      {"path": "/account.html", "purpose": "Account settings"},
      {"path": "/workspace.html", "purpose": "User workspace"}
    ]
  },

  "team_pages": {
    "description": "Internal team only - NOT for public",
    "pages": [
      {"path": "/COMMANDER_COCKPIT.html", "access": "commander"},
      {"path": "/COMMANDER_DASHBOARD.html", "access": "commander"},
      {"path": "/COMMANDER_HOME_BASE.html", "access": "commander"},
      {"path": "/MASTER_COMMAND_CENTER.html", "access": "commander"},
      {"path": "/BUILDER_COCKPIT.html", "access": "team"},
      {"path": "/TEAM_COCKPIT.html", "access": "team"},
      {"path": "/TEAM_DASHBOARD_HUB.html", "access": "team"},
      {"path": "/OPERATOR_COCKPIT_*.html", "access": "team"},
      {"path": "/ADMIN_NEURAL_DASHBOARD.html", "access": "commander"},
      {"path": "/admin-dashboard.html", "access": "commander"},
      {"path": "/PROJECT_HEALTH_DASHBOARD.html", "access": "team"},
      {"path": "/TRINITY_COMMAND_DASHBOARD.html", "access": "team"},
      {"path": "/CONSCIOUSNESS_DASHBOARD.html", "access": "team"},
      {"path": "/CYCLOTRON_BRAIN_DASHBOARD.html", "access": "team"}
    ]
  },

  "private_directories": {
    "description": "Should NEVER be linked from public pages",
    "directories": [
      {"path": "/ARAYA/", "reason": "Internal asset index"},
      {"path": "/ARAYA/DNA/", "reason": "System architecture docs"},
      {"path": "/.tours/", "reason": "Internal tour configs"},
      {"path": "/netlify/functions/", "reason": "Backend code (OK - functions are protected)"}
    ]
  },

  "sensitive_files": {
    "description": "Files containing credentials or internal data",
    "never_deploy": [
      ".env",
      ".env.local",
      "*.pem",
      "*.key",
      "*credentials*",
      "*secrets*"
    ],
    "audit_required": [
      {"file": "admin-dashboard.html", "issue": "Contains Firebase API key - verify rules configured"},
      {"file": "ADMIN_NEURAL_DASHBOARD.html", "issue": "Contains Firebase API key"},
      {"file": "gembot-utils.js", "issue": "Contains Firebase API key"},
      {"file": "GemBot_Control_AI.html", "issue": "Contains Firebase API key"},
      {"file": "merlin-ai-integration.js", "issue": "Contains Google API key"}
    ]
  },

  "gitignore_required": [
    ".env",
    ".env.local",
    "*.pem",
    "*.key",
    ".secrets/",
    "**/credentials.json",
    "**/token.pickle"
  ],

  "robots_txt_recommendation": {
    "disallow": [
      "/COMMANDER_*",
      "/ADMIN_*",
      "/OPERATOR_*",
      "/TEAM_*",
      "/ARAYA/",
      "/*COCKPIT*",
      "/*DASHBOARD*"
    ]
  },

  "quick_check": {
    "is_public_safe": "Does this page expose internal operations, credentials, or team-only info?",
    "has_auth_gate": "Does this page check for login before showing content?",
    "links_to_private": "Does this page link to internal-only pages?"
  }
}
