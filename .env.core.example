# Core Environment Variables (Required for Basic Operation)
# 
# This file contains ONLY the 3 essential variables needed to get started.
# For full configuration options, see .env.example
#
# Quick Start:
# 1. Run: npm run onboard
#    (This automatically generates a .env file with these variables)
# 2. Start the application: npm start
#
# Manual Setup (if needed):
# 1. cp .env.core.example .env
# 2. Edit .env and set the values below
# 3. Run: npm start

# Universe Key - Unique identifier for system access (auto-generated UUID v4)
# This is automatically generated by 'npm run onboard'
UNIVERSE_KEY=your-unique-uuid-here

# Node Environment - Set to 'development' for local work, 'production' for deployment
NODE_ENV=development

# Application Port - Port number for the local development server
PORT=3000
