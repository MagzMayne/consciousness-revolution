{
  "id": "government-contracts",
  "name": "Government Contracts & Grants",
  "version": "0.1.0",
  "description": "Integration with SAM.gov, FPDS, and grants.gov APIs to provide federal contract intelligence, opportunity matching, and grant application facilitation.",
  "purpose": "Generate revenue by matching contributors with government grant opportunities, automating application workflows, and providing market intelligence on federal contracts.",
  "inputs": [
    "SAM.gov API key (from /api/sam-gov-token relay)",
    "User search queries and filters",
    "Contributor profile data (tier, domain expertise)"
  ],
  "outputs": [
    "Contract and grant opportunity listings",
    "AI-matched opportunity recommendations",
    "Automated grant application drafts",
    "Federal spending analytics"
  ],
  "keyFiles": [
    { "path": "government-grants-portal.html", "role": "Main grant portal UI" },
    { "path": "contributor-registration-enhanced.html", "role": "Contributor onboarding with tier selection" },
    { "path": "src/systems/samgov-api-integration.js", "role": "SAM.gov API class with loadApiKeyFromServer()" },
    { "path": "src/utils/samgov-integration.js", "role": "SAM.gov utility class with loadApiKeyFromServer()" },
    { "path": "netlify/functions/sam-gov-token.mjs", "role": "SAM.gov API key relay — server-side only" },
    { "path": "sam-contract-discovery-integration.js", "role": "Contract discovery integration layer" },
    { "path": "grant-contributor-integration.js", "role": "Grant and contributor integration bridge" }
  ],
  "dependencies": [
    { "name": "SAM.gov API", "type": "external-api", "url": "https://open.gsa.gov/api/get-opportunities-public-api/", "secretVar": "SAM_API_KEY" },
    { "name": "grants.gov API", "type": "external-api", "url": "https://www.grants.gov/web/grants/search-grants.html" },
    { "name": "FPDS", "type": "external-api", "url": "https://www.fpds.gov/fpdsng_cms/index.php/en/" }
  ],
  "revenueModel": {
    "contributorTiers": [
      { "tier": "bronze", "price": 50, "revenueShare": 0.10 },
      { "tier": "silver", "price": 200, "revenueShare": 0.12 },
      { "tier": "gold", "price": 500, "revenueShare": 0.15 },
      { "tier": "platinum", "price": 1500, "revenueShare": 0.20 }
    ],
    "studentDiscount": 0.50,
    "platformFee": 0.05
  },
  "securityRules": [
    "SAM.gov API key MUST be fetched from /api/sam-gov-token — never hardcoded in browser JS",
    "Validate all user inputs before building API query strings",
    "Rate-limit requests to external APIs to avoid key suspension"
  ]
}
