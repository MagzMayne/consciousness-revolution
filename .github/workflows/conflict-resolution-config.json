{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Conflict Resolution Configuration",
  "description": "Configuration for automatic conflict resolution strategies",
  "version": "1.0.0",
  "strategies": {
    "default": {
      "name": "Manual Resolution Required",
      "description": "Default strategy when no specific rule matches - requires manual intervention",
      "action": "manual"
    },
    "filePatterns": [
      {
        "pattern": "package-lock.json",
        "strategy": "ours",
        "description": "Always use our package-lock.json and regenerate if needed",
        "autoResolve": true,
        "postResolution": "npm install --package-lock-only"
      },
      {
        "pattern": "yarn.lock",
        "strategy": "ours",
        "description": "Always use our yarn.lock and regenerate if needed",
        "autoResolve": true,
        "postResolution": "yarn install --frozen-lockfile"
      },
      {
        "pattern": "*.md",
        "strategy": "both",
        "description": "Documentation files - attempt to merge both changes",
        "autoResolve": true,
        "safetyCheck": true
      },
      {
        "pattern": "CHANGELOG.md",
        "strategy": "both-prepend",
        "description": "Changelog files - prepend both changes chronologically",
        "autoResolve": true
      },
      {
        "pattern": "projects.json",
        "strategy": "intelligent-merge",
        "description": "Projects catalog - attempt intelligent merge of project entries",
        "autoResolve": true,
        "requiresReview": true,
        "safetyCheck": true
      },
      {
        "pattern": "*.json",
        "strategy": "theirs-with-backup",
        "description": "JSON configuration files - prefer base branch with backup",
        "autoResolve": false,
        "requiresReview": true
      },
      {
        "pattern": ".github/workflows/*.yml",
        "strategy": "manual",
        "description": "Workflow files are critical - require manual review",
        "autoResolve": false,
        "priority": "high"
      },
      {
        "pattern": "*.html",
        "strategy": "intelligent-merge",
        "description": "HTML files - attempt intelligent merge of non-overlapping sections",
        "autoResolve": true,
        "safetyCheck": true
      },
      {
        "pattern": "*.css",
        "strategy": "both",
        "description": "CSS files - merge both changes if not overlapping",
        "autoResolve": true,
        "safetyCheck": true
      },
      {
        "pattern": "*.js",
        "strategy": "manual",
        "description": "JavaScript files require careful review",
        "autoResolve": false,
        "requiresReview": true
      },
      {
        "pattern": "README.md",
        "strategy": "both-merge",
        "description": "README files - merge both changes intelligently",
        "autoResolve": true,
        "safetyCheck": true
      }
    ],
    "conflictTypes": {
      "additions": {
        "description": "Both branches added new content without removing existing",
        "strategy": "both",
        "autoResolve": true,
        "confidence": "high"
      },
      "deletions": {
        "description": "Both branches deleted the same content",
        "strategy": "accept-deletion",
        "autoResolve": true,
        "confidence": "high"
      },
      "whitespace": {
        "description": "Conflicts only in whitespace or formatting",
        "strategy": "normalize",
        "autoResolve": true,
        "confidence": "high"
      },
      "comments": {
        "description": "Conflicts only in comments",
        "strategy": "both",
        "autoResolve": true,
        "confidence": "medium"
      }
    },
    "safetyRules": {
      "maxFileSize": 102400,
      "maxConflictMarkers": 10,
      "requireTestsPass": true,
      "createBackup": true,
      "allowForcePush": false,
      "requireManualReviewFor": [
        "security",
        "authentication",
        "payment",
        "database"
      ]
    },
    "notifications": {
      "onSuccess": {
        "enabled": true,
        "includeSummary": true,
        "includeStrategy": true
      },
      "onPartialResolution": {
        "enabled": true,
        "includeRemainingConflicts": true,
        "provideSuggestions": true
      },
      "onFailure": {
        "enabled": true,
        "includeDetailedReport": true,
        "tagMaintainers": false
      }
    }
  }
}
