# Test Environment Variables
# 
# This file contains properly formatted mock keys for testing purposes.
# These are FAKE keys that match the format of real API keys but won't work for actual API calls.
#
# Use this file for:
# - Unit testing
# - Integration testing
# - CI/CD pipelines
# - Development when you don't need real API access
#
# SECURITY: These are safe to commit - they are mock values only!

# OpenAI Mock Key (matches sk-* format with 48+ chars)
TEST_OPENAI_KEY=sk-test1234567890abcdefghijklmnopqrstuvwxyzABCD

# GitHub Personal Access Token Mock (matches ghp_* format with 36 chars)
TEST_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic Claude Mock Key (matches sk-ant-* format)
TEST_ANTHROPIC_KEY=sk-ant-test1234567890abcdefghijklmnopqrstuvwxyzABCDEF

# Groq API Mock Key (matches gsk_* format)
TEST_GROQ_KEY=gsk_testabcdefghijklmnopqrstuvwxyz1234567890

# Database URL Mock (PostgreSQL format)
TEST_DATABASE_URL=postgresql://testuser:testpass@localhost:5432/testdb

# PayPal Sandbox Credentials (mock format)
TEST_PAYPAL_CLIENT_ID=AVxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TEST_PAYPAL_SECRET=ELxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

